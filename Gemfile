source "https://rubygems.org"

# GitHub Pages builds *.github.io sites with this gem (pins a Jekyll 3.9.x
# compatible toolchain), so building locally with it matches production.
gem "github-pages", group: :jekyll_plugins

# Required by `jekyll serve` on Ruby 3+ (Webrick was unbundled from stdlib).
gem "webrick", "~> 1.8"
